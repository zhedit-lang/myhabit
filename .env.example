# 复制一份成 .env 后修改（.env 不会提交到 Git）

# 登录口令：必填，请改成你自己的口令
APP_PASSWORD=change-me-please

# 会话签名密钥：用于给登录 Cookie 签名，随便一串长随机字符即可
SESSION_SECRET=please-change-this-to-a-long-random-string

# 时区：决定「今天」是哪一天
APP_TZ=Asia/Shanghai

# 会话有效期（秒），默认 180 天
# SESSION_MAX_AGE=15552000

# 数据库位置。默认 <项目目录>/data/myhabit.db
# 在 Zeabur 上建议挂载持久化卷后指向卷内路径，例如 /data/myhabit.db
# DB_PATH=/data/myhabit.db
